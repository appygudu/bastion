{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci",
  "buildCommand": "node scripts/vercel-build.mjs",
  "functions": {
    "app/api/app/scans/route.ts": {
      "maxDuration": 60
    },
    "app/api/app/dependencies/route.ts": {
      "maxDuration": 30
    },
    "app/api/app/reports/[id]/pdf/route.ts": {
      "maxDuration": 30
    },
    "app/api/exposure/domain/route.ts": {
      "maxDuration": 60
    },
    "app/api/exposure/advisories/route.ts": {
      "maxDuration": 30
    },
    "app/api/exposure/email/route.ts": {
      "maxDuration": 20
    },
    "app/api/exposure/package/route.ts": {
      "maxDuration": 20
    },
    "app/api/threats/route.ts": {
      "maxDuration": 30
    },
    "app/api/cron/rescan/route.ts": {
      "maxDuration": 60
    },
    "app/api/exposure/password-range/route.ts": {
      "maxDuration": 20
    }
  },
  "crons": [
    {
      "path": "/api/cron/rescan",
      "schedule": "15 6 * * 1"
    }
  ]
}
