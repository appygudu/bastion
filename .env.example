# Local development uses SQLite. Prisma resolves this path relative to the
# schema file, so the database file is prisma/bastion.db.
# On Vercel, replace this with the pooled Postgres URL (Neon host contains
# "-pooler", or Vercel Postgres POSTGRES_PRISMA_URL). Add
# pgbouncer=true&connection_limit=1 when the host is a pooler.
DATABASE_URL="file:./bastion.db"

# Optional. Prisma Migrate reads DIRECT_URL. On Vercel with the Neon integration
# you do not set this: the build copies DATABASE_URL_UNPOOLED into DIRECT_URL
# when it is unset, then falls back to DATABASE_URL, then POSTGRES_URL_NON_POOLING.
# The running app uses DATABASE_URL only and starts without DIRECT_URL.
# For a local Postgres server with no pooler, set this to the same value as DATABASE_URL.
# DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/bastion?schema=public"

# Set to true on a Vercel deploy to insert the labelled Northwind demo once.
# The seed does nothing when demo@bastion.example already exists. Omit it otherwise.
# SEED_DEMO="true"

# Pepper for session and ingest-key hashes. Required in production.
# At least 32 characters. Example: openssl rand -hex 32
AUTH_SECRET="replace-with-32-plus-random-characters"

# Public origin. An https value marks the session cookie Secure.
APP_URL="http://127.0.0.1:4317"

# Set to true on Vercel. Also implied when VERCEL=1 unless this is exactly "false".
COOKIE_SECURE="false"

# Passive scans per user per window. The counter is stored in the database.
BASTION_SCAN_RATE_LIMIT="8"
BASTION_SCAN_WINDOW_MS="3600000"

# Wall clock for one passive scan, in milliseconds. Kept under the 60s function limit.
BASTION_SCAN_BUDGET_MS="45000"

# Optional https URL for the Team plan button. When unset, the button says Coming soon.
# NEXT_PUBLIC_PAYMENT_LINK_URL="https://buy.stripe.com/example"
# Optional disclosure address shown on the security page. When unset, the page says none is published.
# NEXT_PUBLIC_SECURITY_CONTACT="security@example.com"
# Optional enterprise contact on /pitch. An email or an https URL. When unset, the page says none is published.
# NEXT_PUBLIC_ENTERPRISE_CONTACT="security@example.com"
# At least 16 characters. Vercel Cron sends it as Authorization: Bearer.
# Weekly re-scans run only for Team workspaces, and only when this is set.
# CRON_SECRET=""

# Comma-separated operator emails. These accounts can approve payment claims
# and read security-review requests at /app/admin. The demo account is never an operator.
# ADMIN_EMAILS="you@example.com"

# Optional Resend email. Both are required before any mail is sent.
# Mail goes to Team workspaces only. In-app notifications do not need these.
# RESEND_API_KEY=""
# RESEND_FROM="Bastion <alerts@example.com>"

# Optional OIDC. Set Google, or the generic issuer trio, or both.
# The login page shows a button only when a provider is complete.
# Register the redirect {APP_URL}/api/auth/oidc/callback with the provider.
# SAML is not implemented.
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# OIDC_ISSUER="https://issuer.example.com"
# OIDC_CLIENT_ID=""
# OIDC_CLIENT_SECRET=""
# OIDC_LABEL="Company SSO"
# OIDC_REDIRECT_URI=""

# Optional. When set, the public email check also queries Have I Been Pwned.
# Leave it unset to use the keyless XposedOrNot catalog only.
# The password check never uses this key. It runs in the browser.
# HIBP_API_KEY=""
