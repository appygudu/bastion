{
  "name": "bastion",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node scripts/write-sqlite-schema.mjs && prisma generate --schema prisma/schema.sqlite.prisma && prisma db push --schema prisma/schema.sqlite.prisma && tsx prisma/seed.ts && next dev --turbopack -p 4317 -H 0.0.0.0",
    "build": "prisma generate && next build",
    "start": "next start -p 4317 -H 0.0.0.0",
    "lint": "eslint",
    "test": "node scripts/write-sqlite-schema.mjs --check && vitest run",
    "test:watch": "vitest",
    "db:push": "node scripts/write-sqlite-schema.mjs && prisma db push --schema prisma/schema.sqlite.prisma",
    "db:migrate": "node scripts/with-direct-url.mjs prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "next": "15.5.28",
    "pdfkit": "^0.20.2",
    "prisma": "^6.19.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.5",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "postcss": "8.5.31",
    "deepmerge-ts": "8.0.2"
  }
}
